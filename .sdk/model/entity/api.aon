# Entity: api

main: kit: entity: api: {

  alias: field: {}

  fields: [
    {
      name: "auth"
      req: false
      short: "Authentication method required"
      type: "`$STRING`"
    }
    {
      name: "avgResponseTime"
      req: false
      short: "Average response time in milliseconds"
      type: "`$INTEGER`"
    }
    {
      name: "cors"
      req: false
      short: "Whether CORS is enabled"
      type: "`$BOOLEAN`"
    }
    {
      format: "date-time"
      name: "createdAt"
      req: false
      short: "When the API was added to the directory"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Description of what the API does"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "documentationUrl"
      req: false
      short: "URL to the API documentation"
      type: "`$STRING`"
    }
    {
      name: "endpoints"
      req: false
      short: "Available endpoints for this API"
      type: "`$ARRAY`"
    }
    {
      format: "float"
      name: "errorRate"
      req: false
      short: "Error rate percentage"
      type: "`$NUMBER`"
    }
    {
      name: "https"
      req: false
      short: "Whether the API supports HTTPS"
      type: "`$BOOLEAN`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the API"
      type: "`$INTEGER`"
    }
    {
      format: "date-time"
      name: "lastChecked"
      req: false
      short: "When the API was last checked for availability"
      type: "`$STRING`"
    }
    {
      name: "method"
      req: false
      type: "`$STRING`"
    }
    {
      name: "path"
      req: false
      type: "`$STRING`"
    }
    {
      format: "float"
      name: "reliability"
      req: false
      short: "Reliability percentage based on monitoring"
      type: "`$NUMBER`"
    }
    {
      name: "tags"
      req: false
      short: "Categories/tags associated with the API"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      short: "Name of the API"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      req: false
      short: "Base URL of the API"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "api"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: "best"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/apis"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "apis"
            }
          ]
          select: {
            exist: [
              "limit"
              "page"
              "sort"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
        {
          method: "GET"
          orig: "/api/random"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "random"
            }
          ]
          select: {
            "$action": "random"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: 275
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/api/apis/{id}"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "apis"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
